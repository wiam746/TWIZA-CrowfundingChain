# local (par défaut) ou sepolia
VITE_NETWORK=local

# Obligatoire quand VITE_NETWORK=sepolia ; adresses publiques affichées par deploy.ts
# VITE_CFD_TOKEN_ADDRESS=0x...
# VITE_TREASURY_ADDRESS=0x...
# VITE_CROWDFUNDING_ADDRESS=0x...
# VITE_GOVERNANCE_ADDRESS=0x...

# RPC public optionnel pour ajouter Sepolia dans MetaMask.
# Toute variable VITE_* est intégrée au bundle client ; ne mettez jamais de clé privée ici.
# VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
